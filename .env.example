# ⛔ 本文件只放占位，绝不放真实密钥。复制成 .env 后自行填写；.env 已被 gitignore。
FORGE_API_KEY=
FORGE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
FORGE_MODEL=deepseek-v4.1-flash
FORGE_JUDGE_MODEL=qwen-max
# ── D6 服务化（⛔ 任何真实密钥都⛔ 写进本文件；这里是**形状**示例）───────────
# 设了就走 Postgres 存 trace，没设走 sqlite（本机测试与 CI 不需要容器）
# DATABASE_URL=postgresql://forge:你的本地口令@localhost:5432/forge
# 设了就走 Qdrant 做 dense 索引，没设走 faiss/numpy/纯 python
# FORGE_VECTOR_URL=http://localhost:6333
# docker compose 用的本地口令（仅开发；⛔ 生产，⛔ 提交真实值）
# FORGE_PG_PASSWORD=
# 模型与缓存根（默认 D:/uv；换机器改这一处即可，其他缓存路径由它拼出）
FORGE_CACHE_ROOT=D:/uv
# FORGE_KEEP_TEMP=1   # 想让临时目录跟着系统默认值（⛔ 本项目默认覆盖到 CACHE_ROOT/tmp）
